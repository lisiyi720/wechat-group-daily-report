# Copy this file to config/report.env before first use.

# Absolute directory where reports and raw data will be stored.
# Example: /Users/yourname/Documents/群消息日报
REPORT_ROOT=""

# IANA timezone used to determine day boundaries.
REPORT_TIMEZONE="Asia/Shanghai"

# Maximum messages requested per WeChat group before pagination is needed.
WECHAT_MESSAGE_LIMIT="1000"

# Optional Codex model override. Leave empty to use the CLI default.
CODEX_MODEL=""

# Optional Feishu/Lark notification after a report is generated.
LARK_NOTIFY_CHAT_ID=""
LARK_NOTIFY_AS="user"

